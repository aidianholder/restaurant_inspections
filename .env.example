DJANGO_SECRET_KEY=generate-with-get_random_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com

DB_NAME=health_inspections
DB_USER=health_inspections
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SCRAPER_DELAY_SECONDS=1.5
SCRAPER_USER_AGENT=health-inspections-bot/0.1 (public records research; contact you@example.com)

GEOCODING_ENABLED=True
CENSUS_GEOCODER_DELAY=0.5
# Set these only if GeoDjango can't find the libraries itself (Homebrew/macOS).
# GEOS_LIBRARY_PATH=
# GDAL_LIBRARY_PATH=

# The report PDF supersedes the website's observations overlay; set False to skip
# the overlay request entirely and halve per-inspection load on the ADH server.
SCRAPE_WEB_OBSERVATIONS=True

# Optional. Enables the "Summarize with AI" button on the Output data screen.
# Without it the button is disabled and everything else works as before.
OPEN_AI_TOKEN=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=120
